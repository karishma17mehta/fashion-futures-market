ANTHROPIC_API_KEY=your_key_here
REDDIT_CLIENT_ID=your_reddit_app_id
REDDIT_CLIENT_SECRET=your_reddit_secret
DATABASE_URL=postgresql://user:password@localhost:5432/fashion_futures
REDIS_URL=redis://localhost:6379

# Secret used to sign JWT auth tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins (your deployed frontend URL).
# Localhost and *.vercel.app are allowed automatically.
FRONTEND_ORIGINS=https://your-frontend.vercel.app

# Optional — email alerts & weekly digest (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fashion Futures <alerts@yourdomain.com>
DIGEST_EMAIL=
